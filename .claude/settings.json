{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/session_log.py",
            "timeout": 20,
            "statusMessage": "记录会话工作日志"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/session_log.py",
            "timeout": 20,
            "statusMessage": "压缩前落盘"
          }
        ]
      }
    ]
  }
}
